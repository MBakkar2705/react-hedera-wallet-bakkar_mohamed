# Dependencies and build output are produced inside the image
**/node_modules
**/dist
**/coverage

# Secrets and local data must never enter the build context
**/.env
**/.env.*
**/*.db
**/hedera-wallet

# Not needed to build or run the backend
.git
.github
frontend
docs
backend/test
**/*.md
.idea
.vscode
.DS_Store
backend/Dockerfile
.dockerignore
